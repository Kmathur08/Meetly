PORT=8080
MONGO_URI=mongodb://localhost:27017/meetly

# Comma-separated list of sites allowed to call the API and open sockets.
# Leave empty only for local development; set it in production, e.g. https://meetly.vercel.app
CLIENT_ORIGIN=

# How long a login stays valid, in days.
SESSION_DAYS=7

# Optional TURN relay for people behind strict NATs (mobile data, office networks).
# Example: TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
