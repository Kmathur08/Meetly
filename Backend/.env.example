PORT=8080
MONGO_URI=mongodb://localhost:27017/meetly

# Comma-separated list of sites allowed to call the API and open sockets.
# Leave empty only for local development; set it in production, e.g. https://meetly.vercel.app
CLIENT_ORIGIN=

# How long a login stays valid, in days.
SESSION_DAYS=7

# Optional TURN relay for people behind strict NATs (mobile data, office networks).
# Example: TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Password reset emails, sent through Brevo's HTTP API (free: 300 emails a day).
# Render's free plan blocks SMTP, so an HTTP API is used instead of Gmail SMTP.
# BREVO_API_KEY: Brevo > SMTP & API > API Keys. MAIL_FROM must be a sender verified in Brevo.
# Without these, local development prints the reset link in the terminal instead of emailing it.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Meetly

# Frontend address used in email links. Defaults to the first CLIENT_ORIGIN.
APP_URL=
